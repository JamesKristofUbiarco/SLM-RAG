# Configuración del Servidor FastAPI
HOST=0.0.0.0
PORT=8001
UPLOAD_DIR=uploads
DB_PATH=data/database.db

# Configuración del Motor Whisper/WhisperX
DEVICE=cuda                   # cuda (GPU) o cpu
WHISPER_MODEL=large-v3        # tiny, base, small, medium, large-v3
COMPUTE_TYPE=float16          # float16 (recomendado para GPU), int8, float32
BATCH_SIZE=16                 # tamaño de lote para procesamiento

# Token de Hugging Face para Diarización de Voces (Pyannote)
# Acepta los términos en https://huggingface.co/pyannote/speaker-diarization-3.1 antes de usarlo.
HF_TOKEN=                     # hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Configuración de Ollama (Modelos Locales de Lenguaje)
OLLAMA_URL=http://localhost:11434
LLM_MODEL=gemma4:12b
OLLAMA_CONTEXT_LENGTH=32768   # longitud máxima del contexto para el RAG

# Configuración de Embeddings y RAG
EMBEDDING_MODEL=BAAI/bge-m3  # modelo de vectores locales
EMBEDDING_DEVICE=cuda         # cuda (recomendado para usar GPU) o cpu
CHUNK_SIZE=800                                         # tamaño máximo de caracteres por chunk
CHUNK_OVERLAP=150                                      # caracteres compartidos entre chunks contiguos
